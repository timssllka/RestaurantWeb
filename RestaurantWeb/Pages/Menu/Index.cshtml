@page
@model RestaurantWeb.Pages.Menu.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Меню";
}

<div class="container-fluid">
    <div class="row">
        <!-- Левая боковая панель (без изменений) -->
        <div class="col-md-3 col-lg-2 sidebar p-0">
            <!-- ... -->
        </div>

        <!-- Основное содержимое -->
        <main class="col-md-9 col-lg-7 main-content px-4 py-5">
            <div class="text-center mb-5">
                <h1 style="color: var(--peach);">Наше меню</h1>
                <p class="lead">Попробуйте наши фирменные блюда</p>

                @if (Model.CartMessage != null)
                {
                    <div class="alert alert-info">@Model.CartMessage</div>
                }
            </div>

            <!-- Фильтры (теперь это форма) -->
            <form method="get" class="dish-filters mb-5">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <select class="form-select" name="categoryFilter">
                            <option value="">Все категории</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId" selected="@(category.CategoryId.ToString() ==  Model.CurrentCategoryFilter)">@category.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <select class="form-select" name="seasonFilter">
                            <option value="">Любой сезон</option>
                            <option value="year_round" selected="@("year_round" == Model.CurrentSeasonFilter)">Круглый год</option>
                            <option value="summer" selected="@("summer" == Model.CurrentSeasonFilter)">Летнее</option>
                            <option value="winter" selected="@("winter" == Model.CurrentSeasonFilter)">Зимнее</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary">Применить фильтры</button>
                        @if (!string.IsNullOrEmpty(Model.CurrentCategoryFilter) || !string.IsNullOrEmpty(Model.CurrentSeasonFilter))
                        {
                            <a href="/Menu" class="btn btn-outline-secondary ms-2">Сбросить</a>
                        }
                    </div>
                </div>
            </form>

            <!-- Меню по категориям -->
            @foreach (var category in Model.Categories)
            {
                <div class="menu-category mb-5">
                    <h2 class="category-title mb-4" style="color: var(--peach); border-bottom: 2px solid var(--peach); padding-bottom: 8px;">
                        @category.Name
                    </h2>
                    <p class="category-description mb-4">@category.Description</p>

                    <div class="row">
                        @foreach (var dish in Model.FilteredDishes.Where(d => d.CategoryId == category.CategoryId))
                        {
                            <div class="col-md-6 mb-4">
                                <form method="post" asp-page-handler="AddToCart">
                                    @Html.AntiForgeryToken()

                                    <div class="dish-card-inner h-100 p-3" style="border: 1px solid #eee; border-radius: 8px;">
                                        <input type="hidden" name="dishId" value="@dish.DishId" />

                                        <div class="dish-header d-flex justify-content-between align-items-start">
                                            <h3 style="color: var(--peach);">@dish.Name</h3>
                                            <span class="badge bg-sage">@dish.Price.ToString("N2") ₽</span>
                                        </div>

                                        @if (!string.IsNullOrEmpty(dish.Seasonality))
                                        {
                                            <span class="season-badge @GetSeasonBadgeClass(dish.Seasonality)">
                                                @GetSeasonName(dish.Seasonality)
                                            </span>
                                        }

                                        <p class="dish-composition mt-2">
                                            <i class="bi bi-list-ul me-2" style="color: var(--peach);"></i>
                                            @dish.Composition
                                        </p>

                                        @if (dish.Calories.HasValue)
                                        {
                                            <p class="dish-calories">
                                                <i class="bi bi-fire me-2" style="color: var(--peach);"></i>
                                                @dish.Calories.Value ккал
                                            </p>
                                        }

                                        <div class="d-flex align-items-center mt-3">
                                            <div class="quantity-control me-3">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="this.nextElementSibling.stepDown()">-</button>
                                                <input type="number" name="quantity" class="form-control" value="1" min="1" style="width: 50px; text-align: center;">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="this.previousElementSibling.stepUp()">+</button>
                                            </div>
                                            <button type="submit" class="btn btn-primary flex-grow-1">
                                                <i class="bi bi-cart-plus me-2"></i>Добавить
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </main>

        <!-- Правая боковая панель (корзина) -->
        <div class="col-lg-3 right-sidebar p-4">
            <div class="cart-container sticky-top">
                <h3 class="mb-4" style="color: var(--peach);">
                    <i class="bi bi-cart3 me-2"></i>Ваш заказ
                </h3>

                <div class="cart-items mb-3">
                    @if (Model.CartItems.Any())
                    {
                        @foreach (var item in Model.CartItems)
                        {
                            <form method="post" asp-page-handler="UpdateCartItem" class="cart-item mb-3 p-2 border-bottom">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="dishId" value="@item.DishId" />
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6>@item.DishName</h6>
                                        <div class="d-flex align-items-center mt-1">
                                            <button type="submit" name="action" value="decrease" class="btn btn-sm btn-outline-secondary">-</button>
                                            <input type="number" name="quantity" value="@item.Quantity" min="1"
                                                   class="form-control" style="width: 50px; text-align: center;">
                                            <button type="submit" name="action" value="increase" class="btn btn-sm btn-outline-secondary">+</button>
                                            <span class="ms-2">x @item.Price.ToString("N2") ₽</span>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <span class="me-3">@((item.Price * item.Quantity).ToString("N2")) ₽</span>
                                        <button type="submit" name="action" value="remove" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="empty-cart-message text-muted">
                            Ваша корзина пуста
                        </div>
                    }
                </div>

                <div class="cart-total mb-4">
                    <h5>Итого: @Model.CartTotal.ToString("N2") ₽</h5>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#orderModal">
                        Оформить заказ <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                }
                else
                {
                    <div class="alert alert-warning">
                        <a href="/Login" class="alert-link">Войдите</a>, чтобы оформить заказ
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно оформления заказа -->
<div class="modal fade" id="orderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateOrder">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Оформление заказа</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="tableNumber" class="form-label">Номер стола</label>
                        <select class="form-select" id="tableNumber" name="tableId" required>
                            <option value="">Выберите стол</option>
                            @foreach (var table in Model.AvailableTables)
                            {
                                <option value="@table.TableId">Стол #@table.TableId (@table.Type, @table.Capacity мест)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="orderNotes" class="form-label">Особые пожелания</label>
                        <textarea class="form-control" id="orderNotes" name="notes" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Подтвердить заказ</button>
                </div>
            </form>
        </div>
    </div>
</div>


@functions {
    string GetSeasonName(string seasonality)
    {
        return seasonality switch
        {
            "year_round" => "Круглый год",
            "summer" => "Летнее",
            "winter" => "Зимнее",
            _ => seasonality
        };
    }

    string GetSeasonBadgeClass(string seasonality)
    {
        return seasonality switch
        {
            "year_round" => "bg-sky",
            "summer" => "bg-sage",
            "winter" => "bg-lavender",
            _ => "bg-peach"
        };
    }
}
